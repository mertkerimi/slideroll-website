{
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/flikk", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app-ads.txt", "destination": "/flikk/app-ads.txt" },
    { "source": "/deskwren", "destination": "https://deskwren-website.vercel.app/deskwren" },
    { "source": "/deskwren/(.*)", "destination": "https://deskwren-website.vercel.app/deskwren/$1" },
    { "source": "/flikk/(.*)", "destination": "/flikk/index.html" }
  ]
}
